  "open_decisions": [
    {
      "id": "D-01",
      "category": "API Style",
      "resolution": "同步 + 原生异步双实现（7+7=14 方法，全部显式覆写，完全对等上游 PostgresChatStore）。异步使用 pyvastbase AsyncCollection + AsyncConnections 实现原生 async I/O，不依赖基类 asyncio.to_thread() 默认实现。",
      "rationale": "上游 PostgresChatStore 14 个方法全部原生实现（同步用 psycopg，异步用 asyncpg）。pyvastbase 提供 AsyncCollection + AsyncConnections 原生异步 API，具备实现条件。必须对等上游以保证 drop-in replacement 语义。"
    },
    {
      "id": "D-02",
      "category": "Dependency Strategy",
      "resolution": "完全替换为 pyvastbase Collection API，移除 sqlalchemy/psycopg/asyncpg",
      "rationale": "Vastbase 适配的核心目标是用 pyvastbase 替代 PG 驱动栈"
    },
    {
      "id": "D-03",
      "category": "Error Handling",
      "resolution": "与上游一致：静默 None/空列表，保持 drop-in replacement 语义",
      "rationale": "确保现有 LlamaIndex 用户代码无需修改即可切换后端"
    }
  ],
